proxy_set_header Host $host;    
proxy_set_header Proxy "";
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_set_header ${REAL_IP_PROXY_HEADER} $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Port ${NGINX_X_FORWARDED_PORT};
proxy_set_header X-Forwarded-Proto ${NGINX_X_FORWARDED_PROTO};

proxy_http_version 1.1;
proxy_buffering off;
proxy_connect_timeout 60s;
proxy_read_timeout 36000s;
proxy_redirect off;

proxy_pass_header Authorization;
proxy_pass ${BACKEND};
proxy_cookie_path / "/; SameSite=Lax";

SET_REAL_IP_FROM
real_ip_header ${REAL_IP_HEADER};
real_ip_recursive ${REAL_IP_RECURSIVE};

# Apply rate limiting
# burst=${BURST_LIMIT} allows for small spikes in traffic
# nodelay ensures that requests within the burst limit are processed immediately
limit_req zone=bruteforce burst=${BURST_LIMIT} nodelay;
